# Yangi markaz uchun OCHIQ sozlamalar (lib/center.ts) — nusxa oling, to'ldiring, serverga:
#   scp center.env root@SERVER_IP:/root/center.env && ssh root@SERVER_IP bash /root/deploy/new-center-env.sh
# Qiymatlar qo'shtirnoqsiz yoziladi. Bo'sh qiymat — «yo'q» (havola/logotip/shior chiqmaydi).
# NEXT_PUBLIC_* build paytida kodga yoziladi: o'zgartirgach — qayta deploy.

NEXT_PUBLIC_CENTER_ID=markaz
NEXT_PUBLIC_CENTER_NAME=Markaz o'quv markazi
NEXT_PUBLIC_CENTER_SHORT=Markaz
NEXT_PUBLIC_CENTER_SLOGAN=
NEXT_PUBLIC_CENTER_INSTAGRAM=
NEXT_PUBLIC_CENTER_LOGO=
NEXT_PUBLIC_CENTER_PHONE=
# Bitta filialdek ko'rinadigan binolar («1+2»); bo'sh — yo'q.
NEXT_PUBLIC_BRANCH_POOLS=

PUBLIC_SITE_URL=https://www.markaz.uz
MONGODB_DB=crm
UI_V2_SWITCH=on
