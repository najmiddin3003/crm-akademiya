# Yangi markaz uchun OCHIQ sozlamalar (lib/center.ts) — nusxa oling, to'ldiring, serverga:
#   scp center.env root@SERVER_IP:/root/center.env && ssh root@SERVER_IP bash /root/deploy/new-center-env.sh
# Qiymatlar qo'shtirnoqsiz yoziladi. Bo'sh qiymat — «yo'q» (havola/logotip/shior chiqmaydi).
# NEXT_PUBLIC_* build paytida kodga yoziladi: o'zgartirgach — qayta deploy.

NEXT_PUBLIC_CENTER_ID=markaz
NEXT_PUBLIC_CENTER_NAME=Markaz o'quv markazi
NEXT_PUBLIC_CENTER_SHORT=Markaz
NEXT_PUBLIC_CENTER_SLOGAN=
NEXT_PUBLIC_CENTER_INSTAGRAM=
NEXT_PUBLIC_CENTER_LOGO=
NEXT_PUBLIC_CENTER_PHONE=
# Bitta filialdek ko'rinadigan binolar («1+2»); bo'sh — yo'q.
NEXT_PUBLIC_BRANCH_POOLS=

PUBLIC_SITE_URL=https://www.markaz.uz
# SMS'dagi markaz nomi («CRM-<nom> tizimida ...»); sukut — NEXT_PUBLIC_CENTER_SHORT. Markazning o'z
# Eskiz shabloni tasdiqlanguncha boshqa markazning tasdiqlangan shabloni bilan yuborish uchun
# (ish vaqtida o'qiladi, qayta build shart emas):
# SMS_CENTER_SHORT=Akademiya
# Yoki zaxira Eskiz akkaunti (lib/invite.ts sendCenterSms): asosiy akkaunt shablonni rad etsa
# SMS zaxira akkauntdan shu nom bilan ketadi, o'z shabloni tasdiqlangach o'zi asosiyga o'tadi.
# Maxfiylari set-center-secret.sh bilan: ESKIZ_FALLBACK_EMAIL, ESKIZ_FALLBACK_PASSWORD, ESKIZ_FALLBACK_FROM.
# SMS_FALLBACK_CENTER_SHORT=Akademiya
MONGODB_DB=crm
UI_V2_SWITCH=on

# O'quvchilar boti (ixtiyoriy). Kalitni odamning o'zi kiritadi, qolganini skript yozadi (Git Bash'da):
#   ssh -t root@SERVER_IP bash /root/deploy/set-center-secret.sh TELEGRAM_STUDENT_BOT_TOKEN
#   ssh root@SERVER_IP bash -s < deploy/center-student-bot.sh
# Davomat va to'lov avtomatik xabarlari alohida qaror: STUDENT_BOT_PUSH_ENABLED=true
